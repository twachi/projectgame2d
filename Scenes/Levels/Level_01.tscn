[node name="SmokeText4" type="Label" parent="TutorialText"]
z_index = -1
offset_left = 1638.0
offset_top = 428.0
offset_right = 2097.0
offset_bottom = 609.0
theme = ExtResource("13_07uvp")
theme_override_colors/font_color = Color(0.910156, 0.730469, 0, 1)
theme_override_colors/font_outline_color = Color(0.0646965, 0.0646965, 0.0646965, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 32
text = "ความประมาทของผู้คนทำให้เมืองนี้เต็มไปด้วยมลพิษ 
ได้ปลุก “ผีควัน” ขึ้นมาจากเถ้าถ่าน 
พวกมันออกอาละวาดดูดกลืนชีวิต
และความงามของเมือง"
horizontal_alignment = 1

[node name="SmokeText5" type="Label" parent="TutorialText"]
z_index = -1
offset_left = 4248.0
offset_top = 29.0
offset_right = 4850.0
offset_bottom = 210.0
theme = ExtResource("13_07uvp")
theme_override_colors/font_color = Color(0.910156, 0.730469, 0, 1)
theme_override_colors/font_outline_color = Color(0.111197, 0.111197, 0.111197, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 32
text = "ตำนานเล่าว่า เมื่อมลพิษปกคลุมเมืองจนหนาทึบ 
จะเกิด \"เจ้าพ่อผีควัน\" ร่างยักษ์ที่รวมเอาฝุ่นและผีควันทั้งหมดไว้ในตัว 
และมันจะกักขังดวงวิญญาณของผู้คนไว้ตลอดกาล"
horizontal_alignment = 1

